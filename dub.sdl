name "serverino"
description "Small, fast, zero-dependency web server: HTTP, HTTPS and WebSockets."
authors "Andrea Fontana"
copyright "Copyright © 2023-2026, Andrea Fontana"
license "MIT"

configuration "lib" {
   targetType "library"
}

configuration "https" {
    platforms "posix"
    targetType "library"
    versions "serverino_enable_https"
    libs "ssl" "crypto"
    importPaths "source-tls/"
}

// `dub test`: runs tests/test-* and builds the examples (see tests/all.d)
configuration "unittest" {
   targetType "library"
   sourceFiles "tests/all.d"
}

sourcePaths "source"

subPackage "./init-exec"

dependency ":init-exec" version="*"
x:ddoxTool "scod"
